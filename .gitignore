.DS_Store
.env
.env.*
*.log
.codegraph/
target/
build/
dist/
node_modules/
.dart_tool/
.gradle/
coverage/
*.swp
*.swo

# Local agent runtime state (checkpoints, caches); never commit.
.opencode/

# Python caches from repository tooling (scripts/check_*.py).
__pycache__/
*.pyc

# Preserved migration artifacts from the macOS -> Debian move (2026-10-13).
# Includes a 6 MB Git bundle, a 30 MB session log and a staged patch. Every
# ref they carry is also present in the repository's own history; they exist
# only so the move can be audited once. See docs/archive/legacy/PAUSE_MIGRATION_HANDOFF.md.
/migration-preserved/

# AEH gate report and verification ledger: runtime state, never commit.
.hub/

# Android native build inputs, never source.
# `packages/or_app_bridge/hook/build.dart` refuses an Android build unless the
# staged FFmpeg install exists, and `apps/or_app/pubspec.yaml` pins that path as
# the user define `android_ffmpeg_install_root: android/.ffmpeg-install`.
# `scripts/build_android_case_apks.sh` creates the link and
# `scripts/stage_android_ffmpeg.sh` produces the prefix it points at. Hosted CI
# stages both into a runner temp directory for the same reason.
apps/or_app/android/.ffmpeg-install
apps/or_app/android/app/src/main/jniLibs/
# The Android Gradle plugin's NDK/CMake working directory, created by every
# `assembleDebug` in the module that owns a native library.
packages/or_viewer_texture/android/.cxx/

# Agent workspace runtime state: productions, session work, local scenes and the
# live project. These are user data and can be gigabytes; the workspace source
# and its shipped bundle are the only tracked parts.
tooling/or-agent-workspace/videos/
tooling/or-agent-workspace/work/
tooling/or-agent-workspace/scenes/
tooling/or-agent-workspace/*.orproj
tooling/or-agent-workspace/.*.or-recovery
