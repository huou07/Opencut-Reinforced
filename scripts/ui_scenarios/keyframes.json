{
 "name": "keyframes",
 "harness": "or_ui",
 "description": "Adds an opacity keyframe at the playhead, edits its value in the dialog, applies the Slide up motion preset on the same clip, and confirms both the chip and the preset keyframe are read back. A passing run means the Animation section is reachable in the real inspector, manual and preset keyframes are written through the ordinary clip command, and the panel re-reads them, and the timeline clip shows the animated diamond after the edit. One undo removes the preset's keyframes.",
 "viewport": {
  "width": 1440,
  "height": 900
 },
 "fixtures": [
  "copy:crates/or_media/tests/fixtures/tiny_h264_aac.mp4"
 ],
 "steps": [
  {
   "op": "tap",
   "selector": {
    "key": "nav-projects"
   }
  },
  {
   "op": "tap",
   "selector": {
    "key": "projects-new-project"
   }
  },
  {
   "op": "enter_text",
   "selector": {
    "key": "new-project-name"
   },
   "value": "Keyframes"
  },
  {
   "op": "tap",
   "selector": {
    "key": "confirm-new-project"
   }
  },
  {
   "op": "wait_label",
   "budget_ms": 20000,
   "label_regex": "Import a video"
  },
  {
   "op": "picker",
   "next": "media"
  },
  {
   "op": "tap",
   "selector": {
    "key": "timeline-empty-import-media"
   }
  },
  {
   "op": "wait_label",
   "label_regex": "tiny_h264",
   "budget_ms": 20000
  },
  {
   "op": "tap",
   "selector": {
    "key_regex": "^media-add-timeline-.*$"
   }
  },
  {
   "op": "wait_label",
   "label_regex": "Insert",
   "budget_ms": 10000
  },
  {
   "op": "tap",
   "selector": {
    "key": "timeline-confirm-insert"
   }
  },
  {
   "op": "wait_label",
   "label_regex": "V1",
   "budget_ms": 20000
  },
  {
   "op": "tap",
   "selector": {
    "key_regex": "^timeline-clip-[0-9a-f-]+$"
   }
  },
  {
   "op": "scroll_until",
   "selector": {
    "key": "animation-add-opacity"
   },
   "scroll": "inspector-scroll",
   "dy": -600
  },
  {
   "op": "pump",
   "ms": 300
  },
  {
   "op": "shot",
   "name": "animation-empty"
  },
  {
   "op": "tap",
   "selector": {
    "key": "animation-add-opacity"
   }
  },
  {
   "op": "pump",
   "ms": 300
  },
  {
   "op": "pump",
   "ms": 600
  },
  {
   "op": "scroll_until",
   "selector": {
    "key": "animation-keyframe-opacity-0"
   },
   "scroll": "inspector-scroll",
   "dy": -600
  },
  {
   "op": "shot",
   "name": "animation-one-keyframe"
  },
  {
   "op": "tap",
   "selector": {
    "key": "animation-keyframe-opacity-0"
   }
  },
  {
   "op": "wait",
   "text": "Opacity keyframe",
   "budget_ms": 5000
  },
  {
   "op": "enter_text",
   "selector": {
    "key": "animation-dialog-value"
   },
   "value": "50"
  },
  {
   "op": "tap",
   "selector": {
    "text": "Save"
   }
  },
  {
   "op": "pump",
   "ms": 600
  },
  {
   "op": "expect_absent",
   "key": "animation-dialog-value"
  },
  {
   "op": "scroll_until",
   "selector": {
    "key": "animation-keyframe-opacity-0"
   },
   "scroll": "inspector-scroll",
   "dy": -600
  },
  {
   "op": "expect",
   "key": "animation-keyframe-opacity-0"
  },
  {
   "op": "expect",
   "selector": {
    "key_regex": "^timeline-clip-animated-.*$"
   }
  },
  {
   "op": "tree",
   "name": "edited"
  },
  {
   "op": "shot",
   "name": "animation-edited"
  },
  {
   "op": "scroll_until",
   "selector": {
    "key": "animation-preset-slide-up"
   },
   "scroll": "inspector-scroll",
   "dy": -600
  },
  {
   "op": "tap",
   "selector": {
    "key": "animation-preset-slide-up"
   }
  },
  {
   "op": "pump",
   "ms": 600
  },
  {
   "op": "scroll_until",
   "selector": {
    "key": "animation-keyframe-y-0"
   },
   "scroll": "inspector-scroll",
   "dy": -600
  },
  {
   "op": "expect",
   "key": "animation-keyframe-y-0"
  },
  {
   "op": "tree",
   "name": "preset"
  },
  {
   "op": "shot",
   "name": "animation-preset"
  },
  {
   "op": "tap",
   "selector": {
    "key": "workspace-undo"
   }
  },
  {
   "op": "pump",
   "ms": 600
  },
  {
   "op": "expect_absent",
   "key": "animation-keyframe-y-0"
  },
  {
   "op": "tree",
   "name": "undone"
  },
  {
   "op": "shot",
   "name": "animation-undone"
  }
 ]
}
