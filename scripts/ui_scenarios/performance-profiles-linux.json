{
  "name": "performance-profiles-linux",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "op": "tap",
      "selector": {
        "key": "nav-settings"
      }
    },
    {
      "op": "wait_label",
      "label_regex": "Resources & updates",
      "budget_ms": 20000
    },
    {
      "op": "tap",
      "selector": {
        "key": "settings-section-performance"
      }
    },
    {
      "op": "wait_label",
      "label_regex": "Best for this machine",
      "budget_ms": 30000
    },
    {
      "op": "wait_label",
      "label_regex": "h264_vaapi \\(hardware\\)",
      "budget_ms": 60000
    },
    {
      "op": "wait_label",
      "label_regex": "Nothing is pinned",
      "budget_ms": 20000
    },
    {
      "op": "shot",
      "name": "performance-automatic"
    },
    {
      "op": "tap",
      "selector": {
        "key": "performance-redetect"
      }
    },
    {
      "op": "wait_label",
      "label_regex": "checked just now",
      "budget_ms": 30000
    },
    {
      "op": "shot",
      "name": "performance-redetected"
    }
  ]
}
