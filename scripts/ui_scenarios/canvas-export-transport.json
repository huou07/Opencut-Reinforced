   "budget_ms": 20000
  },
  {
   "op": "tap",
   "selector": {
    "key_regex": "^media-add-timeline-.*$"
   }
  },
  {
   "op": "wait_label",
   "label_regex": "Insert",
   "budget_ms": 10000
