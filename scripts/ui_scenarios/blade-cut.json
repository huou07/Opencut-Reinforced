{
  "name": "blade-cut",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "fixtures": [
    "copy:/Users/meomeo/Documents/vibecode projects/Opencut Reinforced/crates/or_media/tests/fixtures/tiny_h264_aac.mp4"
  ],
  "steps": [
    {
      "op": "shot",
      "name": "home"
    },
    {
      "op": "tap",
      "selector": {
        "key": "nav-projects"
      }
    },
    {
      "op": "tap",
      "selector": {
        "key": "projects-new-project"
      }
    },
    {
      "op": "enter_text",
      "selector": {
        "key": "new-project-name"
      },
      "value": "Blade review"
    },
    {
      "op": "tap",
      "selector": {
        "key": "confirm-new-project"
      }
    },
    {
      "op": "wait",
      "text": "No timeline tracks"
    },
    {
      "op": "tap",
      "selector": {
        "key": "timeline-empty-add-video"
      }
    },
    {
      "op": "wait",
      "text": "V1"
    },
    {
      "op": "picker",
      "next": "media"
    },
    {
      "op": "tap",
      "selector": {
        "key": "media-import"
      }
    },
    {
      "op": "wait",
      "text": "tiny_h264_aac.mp4"
    },
    {
      "op": "tap",
      "selector": {
        "key_regex": "^media-add-timeline-.*$"
      }
    },
    {
      "op": "wait",
      "text": "Insert"
    },
    {
      "op": "tap",
      "selector": {
        "key": "timeline-confirm-insert"
      }
    },
    {
      "op": "expect",
      "key_regex": "^timeline-clip-[0-9a-f-]+$"
    },
    {
      "op": "tap",
      "selector": {
        "key_regex": "^timeline-clip-[0-9a-f-]+$"
      }
    },
    {
      "op": "wait",
      "text": "Split at playhead",
      "budget_ms": 20000
    },
    {
      "op": "key",
      "chord": "c"
    },
    {
      "op": "tree",
      "name": "blade-armed"
    },
    {
      "op": "tap",
      "selector": {
        "key_regex": "^timeline-clip-[0-9a-f-]+$"
      }
    },
    {
      "op": "tree",
      "name": "cut"
    },
    {
      "op": "shot",
      "name": "cut"
    },
    {
      "op": "key",
      "chord": "v"
    },
    {
      "op": "tap",
      "selector": {
        "key_regex": "^timeline-clip-[0-9a-f-]+$"
      },
      "index": 1
    },
    {
      "op": "tap",
      "selector": {
        "key": "inspector-playback-rate"
      }
    },
    {
      "op": "tap",
      "selector": {
        "text": "2×"
      }
    },
    {
      "op": "tree",
      "name": "speed-badge"
    }
  ]
}
