{
  "name": "library-tour",
  "harness": "or_ui",
  "description": "The library a beginner meets: the introduction panel (brought back through the command palette, so the tour never depends on first-run state), then every library tab by its visible content. Every step names a widget key or visible text.",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "steps": [
    {
      "op": "shot",
      "name": "home-first-run"
    },
    {
      "op": "key",
      "chord": "cmd+k"
    },
    {
      "op": "pump",
      "ms": 700
    },
    {
      "op": "enter_text",
      "selector": {
        "key": "command-palette-query"
      },
      "value": "Show the Introduction"
    },
    {
      "op": "pump",
      "ms": 400
    },
    {
      "op": "tap",
      "selector": {
        "key": "command-show-the-introduction"
      }
    },
    {
      "op": "pump",
      "ms": 700
    },
    {
      "op": "wait_label",
      "label_regex": "Start here",
      "budget_ms": 30000
    },
    {
      "op": "expect",
      "key": "home-welcome"
    },
    {
      "op": "tap",
      "selector": {
        "key": "home-welcome-library"
      }
    },
    {
      "op": "pump",
      "ms": 900
    },
    {
      "op": "expect",
      "key": "library-tabs"
    },
    {
      "op": "shot",
      "name": "templates"
    },
    {
      "op": "tap",
      "selector": {
        "key": "library-tab-text"
      }
    },
    {
      "op": "pump",
      "ms": 600
    },
    {
      "op": "shot",
      "name": "text"
    },
    {
      "op": "tap",
      "selector": {
        "key": "library-tab-sound"
      }
    },
    {
      "op": "pump",
      "ms": 600
    },
    {
      "op": "shot",
      "name": "sound"
    },
    {
      "op": "tap",
      "selector": {
        "key": "library-tab-guide"
      }
    },
    {
      "op": "pump",
      "ms": 600
    },
    {
      "op": "shot",
      "name": "guide"
    },
    {
      "op": "tree",
      "name": "guide"
    },
    {
      "op": "expect",
      "key": "library-credits"
    },
    {
      "op": "expect",
      "key": "library-credit-licence-inter"
    },
    {
      "op": "expect",
      "key": "library-credit-licence-sound-effects"
    },
    {
      "op": "tap",
      "selector": {
        "key": "nav-home"
      }
    },
    {
      "op": "pump",
      "ms": 600
    },
    {
      "op": "tap",
      "selector": {
        "key": "home-welcome-dismiss"
      }
    },
    {
      "op": "pump",
      "ms": 600
    },
    {
      "op": "expect_absent",
      "key": "home-welcome"
    },
    {
      "op": "shot",
      "name": "home-without-welcome"
    }
  ]
}
