{
  "name": "ui-audit-chrome",
  "harness": "or_ui",
  "viewport": { "width": 1440, "height": 900 },
  "description": "Reads every shell destination and every Settings section with no project open, so the audit sees the empty states, the labels and the first-run surface rather than only the loaded editor.",
  "fixtures": [],
  "steps": [
    { "op": "tree", "name": "home" },
    { "op": "shot", "name": "home" },
    { "op": "tap", "selector": { "key": "nav-projects" } },
    { "op": "tree", "name": "projects" },
    { "op": "shot", "name": "projects" },
    { "op": "tap", "selector": { "key": "nav-library" } },
    { "op": "tree", "name": "library" },
    { "op": "shot", "name": "library" },
    { "op": "tap", "selector": { "key": "nav-settings" } },
    { "op": "wait_key", "key": "settings-section-resources", "budget_ms": 30000 },
    { "op": "tree", "name": "settings-resources" },
    { "op": "shot", "name": "settings-resources" },
    { "op": "tap", "selector": { "key": "settings-section-performance" } },
    { "op": "tree", "name": "settings-performance" },
    { "op": "shot", "name": "settings-performance" },
    { "op": "tap", "selector": { "key": "settings-section-assistant" } },
    { "op": "tree", "name": "settings-assistant" },
    { "op": "shot", "name": "settings-assistant" },
    { "op": "tap", "selector": { "key": "settings-section-appearance" } },
    { "op": "tree", "name": "settings-appearance" },
    { "op": "shot", "name": "settings-appearance" },
    { "op": "tap", "selector": { "key": "settings-section-general" } },
    { "op": "tree", "name": "settings-general" },
    { "op": "shot", "name": "settings-general" },
    { "op": "tap", "selector": { "key": "settings-section-advanced" } },
    { "op": "tree", "name": "settings-advanced" },
    { "op": "shot", "name": "settings-advanced" }
  ]
}
