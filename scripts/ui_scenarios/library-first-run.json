{
  "name": "library-first-run",
  "harness": "or_ui",
  "description": "The beginner path the library exists for: a first-run Home panel that explains the product, an in-app guide reachable without a project, and a template that creates a canvas and starter text through the ordinary commands. Every step names a widget key or a visible string; no step injects project state.",
  "viewport": { "width": 1440, "height": 900 },
  "steps": [
    { "op": "shot", "name": "home-first-run" },
    { "op": "tree", "name": "home-first-run" },
    { "op": "expect", "key": "home-welcome" },
    { "op": "expect", "key": "home-welcome-new", "role": "button" },
    { "op": "expect", "key": "home-library", "role": "button" },
    { "op": "tap", "selector": { "key": "home-welcome-library" } },
    { "op": "pump", "ms": 900 },
    { "op": "expect", "key": "library-tabs" },
    { "op": "shot", "name": "library-templates" },
    { "op": "expect", "key": "library-template-use-landscape-1080p" },
    { "op": "tap", "selector": { "key": "library-tab-guide" } },
    { "op": "wait", "text": "Your first project", "budget_ms": 20000 },
    { "op": "shot", "name": "library-guide" },
    { "op": "tree", "name": "library-guide" },
    { "op": "tap", "selector": { "key": "library-tab-templates" } },
    { "op": "pump", "ms": 600 },
    { "op": "tap", "selector": { "key": "library-template-use-landscape-1080p" } },
    { "op": "pump", "ms": 900 },
    { "op": "enter_text", "selector": { "key": "new-project-name" }, "value": "Library template journey" },
    { "op": "tap", "selector": { "key": "confirm-new-project" } },
    { "op": "wait", "text": "Untitled", "budget_ms": 40000 },
    { "op": "shot", "name": "template-editor" },
    { "op": "tree", "name": "template-editor" },
    { "op": "expect", "key_regex": "^timeline-clip-[0-9a-f-]+$" },
    { "op": "tap", "selector": { "key": "editor-tool-text" } },
    { "op": "pump", "ms": 700 },
    { "op": "shot", "name": "template-text-panel" },
    { "op": "tree", "name": "template-text-panel" }
  ]
}
