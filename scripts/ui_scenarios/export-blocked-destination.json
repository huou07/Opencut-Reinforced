{
 "name": "export-blocked-destination",
 "viewport": {
  "width": 1440,
  "height": 900
 },
 "fixtures": [
  "copy:crates/or_media/tests/fixtures/tiny_h264_aac.mp4"
 ],
 "steps": [
  {
   "op": "tap",
   "selector": {
    "key": "nav-projects"
   }
  },
  {
   "op": "tap",
   "selector": {
    "key": "projects-new-project"
   }
  },
  {
   "op": "enter_text",
   "selector": {
    "key": "new-project-name"
   },
   "value": "Packaged export"
  },
  {
   "op": "tap",
   "selector": {
    "key": "confirm-new-project"
   }
  },
  {
   "op": "wait_label",
   "label_regex": "No timeline tracks",
   "budget_ms": 15000
  },
  {
   "op": "picker",
   "next": "media"
  },
  {
   "op": "tap",
   "selector": {
    "key": "timeline-empty-add-video"
   }
  },
  {
   "op": "wait_label",
   "label_regex": "V1",
   "budget_ms": 15000
  },
  {
   "op": "tap",
   "selector": {
    "key": "media-import"
   }
  },
  {
   "op": "wait_label",
   "label_regex": "tiny_h264",
   "budget_ms": 20000
  },
  {
   "op": "tap",
   "selector": {
    "key_regex": "^media-add-timeline-.*$"
   }
  },
  {
   "op": "wait_label",
   "label_regex": "Insert",
   "budget_ms": 10000
  },
  {
   "op": "tap",
   "selector": {
    "key": "timeline-confirm-insert"
   }
  },
  {
   "op": "wait_label",
   "label_regex": "V1",
   "budget_ms": 20000
  },
  {
   "op": "tap",
   "selector": {
    "key": "workspace-save"
   }
  },
  {
   "op": "wait_label",
   "label_regex": "Saved",
   "budget_ms": 15000
  },
  {
   "op": "tap",
   "selector": {
    "key": "export-project"
   }
  },
  {
   "op": "wait",
   "text": "Export video",
   "budget_ms": 10000
  },
  {
   "op": "tap",
   "selector": {
    "text": "Continue"
   }
  },
  {
   "op": "wait_label",
   "label_regex": "did not allow this app to write",
   "budget_ms": 20000
  },
  {
   "op": "wait_label",
   "label_regex": "Choose a folder inside your home folder",
   "budget_ms": 10000
  },
  {
   "op": "tree",
   "name": "export-blocked-notice"
  },
  {
   "op": "shot",
   "name": "export-blocked-notice"
  }
 ],
 "description": "Exports into a folder that refuses new entries, the way a protected macOS folder does. The app has to say which folder it could not write in and what to do, before a job starts, instead of reporting a bare FFmpeg permission error.",
 "exportWriteDenied": true
}
